#!/bin/sh
# Nagi Shell launcher - generated by install.sh; safe to edit NAGI_DEST only.
NAGI_DEST="@NAGI_DEST@"

if [ "${1:-}" = "--session-service" ]; then
    [ "$#" -eq 1 ] || {
        printf '%s\n' "nagi-shell: --session-service accepts no additional arguments" >&2
        exit 64
    }
    QML_IMPORT_PATH="$NAGI_DEST/build/qml"
    export QML_IMPORT_PATH
    exec qs -p "$NAGI_DEST" --no-duplicate
fi

open_control_center=0
if [ "${1:-}" = "--control-center" ]; then
    [ "$#" -eq 1 ] || {
        printf '%s\n' "nagi-shell: --control-center accepts no additional arguments" >&2
        exit 64
    }
    if qs -p "$NAGI_DEST" ipc call nagi activate control-center >/dev/null 2>&1; then
        exit 0
    fi
    open_control_center=1
fi

QML_IMPORT_PATH="$NAGI_DEST/build/qml"
export QML_IMPORT_PATH
config_home="${XDG_CONFIG_HOME:-${HOME:?HOME is required}/.config}"
unit_file="$config_home/systemd/user/nagi-shell.service"
unit_installed=0
if [ -e "$unit_file" ] || [ -L "$unit_file" ]; then
    unit_installed=1
fi

start_installed_unit() {
    command -v systemctl >/dev/null 2>&1 || {
        printf '%s\n' "nagi-shell: systemctl is required to start the installed user service" >&2
        exit 1
    }
    if ! systemctl --user start nagi-shell.service; then
        printf '%s\n' "nagi-shell: failed to start nagi-shell.service" >&2
        exit 1
    fi
}

if [ "$open_control_center" -eq 0 ]; then
    if [ "$#" -eq 0 ] && [ "$unit_installed" -eq 1 ]; then
        start_installed_unit
        exit 0
    fi
    exec qs -p "$NAGI_DEST" --no-duplicate "$@"
fi

if [ "$unit_installed" -eq 1 ]; then
    start_installed_unit
else
    # Developer checkout fallback: no installed unit exists to own startup.
    qs -p "$NAGI_DEST" --no-duplicate >/dev/null 2>&1 &
fi

attempt=0
while [ "$attempt" -lt 50 ]; do
    if qs -p "$NAGI_DEST" ipc call nagi activate control-center >/dev/null 2>&1; then
        exit 0
    fi
    attempt=$((attempt + 1))
    sleep 0.1
done
printf '%s\n' "nagi-shell: Control Center activation timed out" >&2
exit 1
